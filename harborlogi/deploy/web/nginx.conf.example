# Waitress must bind only 127.0.0.1:8060; firewall prohibits external access.
# Set HARBOR_WEB_TRUSTED_PROXY=1 only for this host-owned loopback proxy.
server {
    listen 443 ssl;
    server_name harbor.example.invalid;
    ssl_certificate /path/to/fullchain.pem;
    ssl_certificate_key /path/to/private-key.pem;
    location / {
        proxy_set_header Host harbor.example.invalid;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header Forwarded "";
        proxy_pass http://127.0.0.1:8060;
    }
}
