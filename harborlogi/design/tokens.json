    "breakpoint": {
      "tablet": {"$type": "dimension", "$value": "768px"},
      "desktop": {"$type": "dimension", "$value": "1280px"}
    },
    "motion": {
      "feedback": {"$type": "duration", "$value": "120ms"},
      "navigation": {"$type": "duration", "$value": "180ms"},
      "reduced": {"$type": "duration", "$value": "0ms"},
      "ease": {"$type": "cubicBezier", "$value": [0.16, 1, 0.3, 1]}
    },
    "layer": {
      "base": {"$type": "number", "$value": 0},
      "sticky": {"$type": "number", "$value": 10},
      "popover": {"$type": "number", "$value": 20},
      "dialog": {"$type": "number", "$value": 30},
      "notification": {"$type": "number", "$value": 40}
    }
  },
  "semantic": {
    "surface": {
      "canvas": {"$type": "color", "$value": "{primitive.color.paper}"},
      "panel": {"$type": "color", "$value": "{primitive.color.white}"},
      "navigation": {"$type": "color", "$value": "{primitive.color.navy}"},
      "navigation-selected": {"$type": "color", "$value": "{primitive.color.teal}"},
      "selected": {"$type": "color", "$value": "{primitive.color.teal-soft}"},
      "disabled": {"$type": "color", "$value": "{primitive.color.unknown-soft}"},
      "table-header": {"$type": "color", "$value": "{primitive.color.navy-soft}"},
      "row-hover": {"$type": "color", "$value": "{primitive.color.teal-50}"}
    },
    "text": {
      "primary": {"$type": "color", "$value": "{primitive.color.ink}"},
      "secondary": {"$type": "color", "$value": "{primitive.color.muted}"},
      "inverse": {"$type": "color", "$value": "{primitive.color.white}"},
      "selected": {"$type": "color", "$value": "{primitive.color.teal-hover}"},
      "link": {"$type": "color", "$value": "{primitive.color.teal-dark}"}
    },
    "action": {
      "primary": {"$type": "color", "$value": "{primitive.color.teal-dark}"},
      "hover": {"$type": "color", "$value": "{primitive.color.teal-hover}"},
      "foreground": {"$type": "color", "$value": "{primitive.color.white}"}
    },
    "border": {
      "divider": {"$type": "color", "$value": "{primitive.color.line}"},
