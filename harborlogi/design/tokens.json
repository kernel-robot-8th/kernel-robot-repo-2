{
  "schema": "harbor.design-tokens/1",
  "meta": {
    "status": "adopted",
    "runtimeConsumer": true,
    "purpose": "HarborLogi 로고 대표색과 파생 톤, 용도·컴포넌트별 색상 상태의 정본. tools/design_tokens.py에서 CSS를 생성한다.",
    "confirmed": "기존 브랜드 유지, PC 중심 웹과 태블릿 보조, 조치 필요 중심 PC 첫 화면",
    "extensions": "성공·위험·미확인 색상, body 16px, 탐색 크기와 의미별 alias를 로컬 조회 페이지에 적용한다. 운영·실물 수용과 구분한다."
  },
  "primitive": {
    "color": {
      "navy": {"$type": "color", "$value": "#112c3f"},
      "ink": {"$type": "color", "$value": "#17364b"},
      "muted": {"$type": "color", "$value": "#506878"},
      "teal": {"$type": "color", "$value": "#2cbbb7"},
      "teal-soft": {"$type": "color", "$value": "#daf5f2"},
      "orange": {"$type": "color", "$value": "#fe6d08"},
      "orange-soft": {"$type": "color", "$value": "#fff1da"},
      "warning-ink": {"$type": "color", "$value": "#873c0a"},
      "paper": {"$type": "color", "$value": "#f4f8fb"},
      "white": {"$type": "color", "$value": "#ffffff"},
      "line": {"$type": "color", "$value": "#d7e3e9"},
      "control-border": {"$type": "color", "$value": "#6b8292"},
      "focus": {"$type": "color", "$value": "#b94d00"},
      "success-ink": {"$type": "color", "$value": "#167044"},
      "success-soft": {"$type": "color", "$value": "#e1f7ea"},
      "danger-ink": {"$type": "color", "$value": "#b72d43"},
      "danger-soft": {"$type": "color", "$value": "#fff0f2"},
      "unknown-soft": {"$type": "color", "$value": "#e7eef6"},
      "teal-dark": {"$type": "color", "$value": "#087c80"},
      "teal-50": {"$type": "color", "$value": "#effbfa"},
      "teal-hover": {"$type": "color", "$value": "#08636b"},
