      "radius": {"$type": "dimension", "$value": "{primitive.radius.control}"},
      "padding-x": {"$type": "dimension", "$value": "{primitive.space.4}"},
      "disabled-background": {"$type": "color", "$value": "{semantic.surface.disabled}"},
      "disabled-foreground": {"$type": "color", "$value": "{semantic.text.secondary}"},
      "border": {"$type": "color", "$value": "{semantic.action.primary}"},
      "focus-ring": {"$type": "color", "$value": "{semantic.focus.on-light}"}
    },
    "navigation": {
      "width": {"$type": "dimension", "$value": "{primitive.size.navigation}"},
      "rail-width": {"$type": "dimension", "$value": "76px"},
      "background": {"$type": "color", "$value": "{semantic.surface.navigation}"},
      "foreground": {"$type": "color", "$value": "{semantic.text.inverse}"},
      "selected-background": {"$type": "color", "$value": "{semantic.surface.navigation-selected}"},
      "selected-foreground": {"$type": "color", "$value": "{semantic.text.primary}"},
      "item-min-height": {"$type": "dimension", "$value": "{primitive.size.touch-control}"}
    },
    "work-row": {
      "min-height": {"$type": "dimension", "$value": "{primitive.size.row}"},
      "touch-min-height": {"$type": "dimension", "$value": "{primitive.size.touch-row}"},
      "selected-background": {"$type": "color", "$value": "{semantic.surface.selected}"},
      "selected-border": {"$type": "color", "$value": "{semantic.border.selected}"},
      "gap": {"$type": "dimension", "$value": "{primitive.space.3}"}
    },
    "tabs": {
      "min-height": {"$type": "dimension", "$value": "{primitive.size.touch-control}"},
