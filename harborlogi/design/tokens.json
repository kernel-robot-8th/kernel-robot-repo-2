    },
    "focus": {
      "on-light": {"$type": "color", "$value": "{primitive.color.focus}"},
      "on-inverse": {"$type": "color", "$value": "{primitive.color.paper}"},
      "width": {"$type": "dimension", "$value": "{primitive.border.focus}"},
      "offset": {"$type": "dimension", "$value": "{primitive.border.focus}"}
    },
    "status": {
      "info": {
        "foreground": {"$type": "color", "$value": "{primitive.color.teal-hover}"},
        "background": {"$type": "color", "$value": "{primitive.color.teal-soft}"}
      },
      "warning": {
        "foreground": {"$type": "color", "$value": "{primitive.color.warning-ink}"},
        "background": {"$type": "color", "$value": "{primitive.color.orange-soft}"}
      },
      "danger": {
        "foreground": {"$type": "color", "$value": "{primitive.color.danger-ink}"},
        "background": {"$type": "color", "$value": "{primitive.color.danger-soft}"}
      },
      "success": {
        "foreground": {"$type": "color", "$value": "{primitive.color.success-ink}"},
        "background": {"$type": "color", "$value": "{primitive.color.success-soft}"}
      },
      "unknown": {
        "foreground": {"$type": "color", "$value": "{primitive.color.muted}"},
        "background": {"$type": "color", "$value": "{primitive.color.unknown-soft}"}
      }
    },
    "type": {
      "family": {"$type": "fontFamily", "$value": "{primitive.font.ui}"},
      "body": {"$type": "dimension", "$value": "{primitive.font.body}"},
      "label": {"$type": "dimension", "$value": "{primitive.font.label}"},
      "metadata": {"$type": "dimension", "$value": "{primitive.font.caption}"},
      "section": {"$type": "dimension", "$value": "{primitive.font.section}"},
      "page": {"$type": "dimension", "$value": "{primitive.font.page}"}
    }
  },
  "component": {
    "button": {
      "background": {"$type": "color", "$value": "{semantic.action.primary}"},
      "foreground": {"$type": "color", "$value": "{semantic.action.foreground}"},
      "hover": {"$type": "color", "$value": "{semantic.action.hover}"},
      "min-height": {"$type": "dimension", "$value": "{primitive.size.control}"},
