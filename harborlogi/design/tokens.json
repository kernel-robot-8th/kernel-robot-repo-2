      "caption": {"$type": "dimension", "$value": "0.75rem"},
      "label": {"$type": "dimension", "$value": "0.875rem"},
      "body": {"$type": "dimension", "$value": "1rem"},
      "section": {"$type": "dimension", "$value": "1.125rem"},
      "page": {"$type": "dimension", "$value": "1.75rem"},
      "regular": {"$type": "number", "$value": 400},
      "medium": {"$type": "number", "$value": 500},
      "strong": {"$type": "number", "$value": 600},
      "bold": {"$type": "number", "$value": 700},
      "body-line": {"$type": "number", "$value": 1.6},
      "heading-line": {"$type": "number", "$value": 1.3}
    },
    "space": {
      "1": {"$type": "dimension", "$value": "0.25rem"},
      "2": {"$type": "dimension", "$value": "0.5rem"},
      "3": {"$type": "dimension", "$value": "0.75rem"},
      "4": {"$type": "dimension", "$value": "1rem"},
      "6": {"$type": "dimension", "$value": "1.5rem"},
      "8": {"$type": "dimension", "$value": "2rem"},
      "12": {"$type": "dimension", "$value": "3rem"},
      "16": {"$type": "dimension", "$value": "4rem"}
    },
    "radius": {
      "small": {"$type": "dimension", "$value": "4px"},
      "control": {"$type": "dimension", "$value": "6px"},
      "panel": {"$type": "dimension", "$value": "8px"}
    },
    "border": {
      "thin": {"$type": "dimension", "$value": "1px"},
      "focus": {"$type": "dimension", "$value": "3px"}
    },
    "size": {
      "control": {"$type": "dimension", "$value": "44px"},
      "touch-control": {"$type": "dimension", "$value": "48px"},
