      "selected-line": {"$type": "color", "$value": "{semantic.border.selected}"}
    },
    "section": {
      "background": {"$type": "color", "$value": "{semantic.surface.panel}"},
      "padding": {"$type": "dimension", "$value": "{primitive.space.6}"},
      "gap": {"$type": "dimension", "$value": "{primitive.space.8}"},
      "radius": {"$type": "dimension", "$value": "{primitive.radius.panel}"}
