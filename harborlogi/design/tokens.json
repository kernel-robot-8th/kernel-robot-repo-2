    "table": {
      "header-background": {"$type": "color", "$value": "{semantic.surface.table-header}"},
      "header-foreground": {"$type": "color", "$value": "{semantic.text.secondary}"},
      "row-background": {"$type": "color", "$value": "{semantic.surface.panel}"},
      "row-hover-background": {"$type": "color", "$value": "{semantic.surface.row-hover}"},
      "border": {"$type": "color", "$value": "{semantic.border.divider}"}
    },
    "input": {
      "background": {"$type": "color", "$value": "{semantic.surface.panel}"},
      "foreground": {"$type": "color", "$value": "{semantic.text.primary}"},
      "placeholder": {"$type": "color", "$value": "{semantic.text.secondary}"},
      "border": {"$type": "color", "$value": "{semantic.border.control}"},
      "focus-border": {"$type": "color", "$value": "{semantic.action.primary}"}
    }
  }
