{
  "schema": "harbor.design-tokens/1",
  "meta": {
    "status": "proposal",
    "runtimeConsumer": false,
    "purpose": "다음 네비게이션·공통 컴포넌트 구현 기준. 현재 CSS를 변경하거나 생성하지 않는다.",
    "confirmed": "기존 브랜드 유지, PC 중심 웹과 태블릿 보조, 조치 필요 중심 PC 첫 화면",
    "extensions": "성공·위험·미확인 색상, body 16px, 탐색 크기와 의미별 alias는 신규 제안이다."
  },
  "primitive": {
    "color": {
      "navy": {"$type": "color", "$value": "#102e40"},
      "ink": {"$type": "color", "$value": "#183748"},
      "muted": {"$type": "color", "$value": "#526775"},
      "teal": {"$type": "color", "$value": "#116974"},
      "teal-soft": {"$type": "color", "$value": "#e2efed"},
      "orange": {"$type": "color", "$value": "#b84413"},
      "orange-soft": {"$type": "color", "$value": "#fff0e4"},
      "warning-ink": {"$type": "color", "$value": "#81320f"},
      "paper": {"$type": "color", "$value": "#f5f2eb"},
      "white": {"$type": "color", "$value": "#ffffff"},
      "line": {"$type": "color", "$value": "#d6dedc"},
      "control-border": {"$type": "color", "$value": "#83959c"},
      "focus": {"$type": "color", "$value": "#a53709"},
      "success-ink": {"$type": "color", "$value": "#226345"},
      "success-soft": {"$type": "color", "$value": "#e5f2e9"},
      "danger-ink": {"$type": "color", "$value": "#a52c31"},
      "danger-soft": {"$type": "color", "$value": "#fcebec"},
      "unknown-soft": {"$type": "color", "$value": "#e8edef"}
    },
    "font": {
      "ui": {"$type": "fontFamily", "$value": "\"Segoe UI\", \"Malgun Gothic\", \"Apple SD Gothic Neo\", \"Noto Sans KR\", sans-serif"},
      "caption": {"$type": "dimension", "$value": "0.75rem"},
      "label": {"$type": "dimension", "$value": "0.875rem"},
      "body": {"$type": "dimension", "$value": "1rem"},
      "section": {"$type": "dimension", "$value": "1.125rem"},
      "page": {"$type": "dimension", "$value": "1.75rem"},
      "regular": {"$type": "number", "$value": 400},
      "medium": {"$type": "number", "$value": 500},
      "strong": {"$type": "number", "$value": 600},
      "bold": {"$type": "number", "$value": 700},
      "body-line": {"$type": "number", "$value": 1.6},
      "heading-line": {"$type": "number", "$value": 1.3}
    },
    "space": {
      "1": {"$type": "dimension", "$value": "0.25rem"},
      "2": {"$type": "dimension", "$value": "0.5rem"},
      "3": {"$type": "dimension", "$value": "0.75rem"},
      "4": {"$type": "dimension", "$value": "1rem"},
      "6": {"$type": "dimension", "$value": "1.5rem"},
      "8": {"$type": "dimension", "$value": "2rem"},
      "12": {"$type": "dimension", "$value": "3rem"},
      "16": {"$type": "dimension", "$value": "4rem"}
    },
    "radius": {
      "small": {"$type": "dimension", "$value": "4px"},
      "control": {"$type": "dimension", "$value": "6px"},
      "panel": {"$type": "dimension", "$value": "8px"}
    },
    "border": {
      "thin": {"$type": "dimension", "$value": "1px"},
      "focus": {"$type": "dimension", "$value": "3px"}
    },
    "size": {
      "control": {"$type": "dimension", "$value": "44px"},
      "touch-control": {"$type": "dimension", "$value": "48px"},
      "row": {"$type": "dimension", "$value": "56px"},
      "touch-row": {"$type": "dimension", "$value": "64px"},
      "topbar": {"$type": "dimension", "$value": "64px"},
      "navigation": {"$type": "dimension", "$value": "200px"},
      "work-list": {"$type": "dimension", "$value": "280px"},
      "read-measure": {"$type": "dimension", "$value": "72ch"}
    },
    "breakpoint": {
      "tablet": {"$type": "dimension", "$value": "768px"},
      "desktop": {"$type": "dimension", "$value": "1280px"}
    },
    "motion": {
      "feedback": {"$type": "duration", "$value": "120ms"},
      "navigation": {"$type": "duration", "$value": "180ms"},
      "reduced": {"$type": "duration", "$value": "0ms"},
      "ease": {"$type": "cubicBezier", "$value": [0.16, 1, 0.3, 1]}
    },
    "layer": {
      "base": {"$type": "number", "$value": 0},
      "sticky": {"$type": "number", "$value": 10},
      "popover": {"$type": "number", "$value": 20},
      "dialog": {"$type": "number", "$value": 30},
      "notification": {"$type": "number", "$value": 40}
    }
  },
  "semantic": {
    "surface": {
      "canvas": {"$type": "color", "$value": "{primitive.color.paper}"},
      "panel": {"$type": "color", "$value": "{primitive.color.white}"},
      "navigation": {"$type": "color", "$value": "{primitive.color.navy}"},
      "selected": {"$type": "color", "$value": "{primitive.color.teal-soft}"},
      "disabled": {"$type": "color", "$value": "{primitive.color.unknown-soft}"}
    },
    "text": {
      "primary": {"$type": "color", "$value": "{primitive.color.ink}"},
      "secondary": {"$type": "color", "$value": "{primitive.color.muted}"},
      "inverse": {"$type": "color", "$value": "{primitive.color.paper}"},
      "selected": {"$type": "color", "$value": "{primitive.color.teal}"},
      "link": {"$type": "color", "$value": "{primitive.color.teal}"}
    },
    "action": {
      "primary": {"$type": "color", "$value": "{primitive.color.teal}"},
      "hover": {"$type": "color", "$value": "{primitive.color.navy}"},
      "foreground": {"$type": "color", "$value": "{primitive.color.white}"}
    },
    "border": {
      "divider": {"$type": "color", "$value": "{primitive.color.line}"},
      "control": {"$type": "color", "$value": "{primitive.color.control-border}"},
      "selected": {"$type": "color", "$value": "{primitive.color.teal}"}
    },
    "focus": {
      "on-light": {"$type": "color", "$value": "{primitive.color.focus}"},
      "on-inverse": {"$type": "color", "$value": "{primitive.color.paper}"},
      "width": {"$type": "dimension", "$value": "{primitive.border.focus}"},
      "offset": {"$type": "dimension", "$value": "{primitive.border.focus}"}
    },
    "status": {
      "info": {
        "foreground": {"$type": "color", "$value": "{primitive.color.teal}"},
        "background": {"$type": "color", "$value": "{primitive.color.teal-soft}"}
      },
      "warning": {
        "foreground": {"$type": "color", "$value": "{primitive.color.warning-ink}"},
        "background": {"$type": "color", "$value": "{primitive.color.orange-soft}"}
      },
      "danger": {
        "foreground": {"$type": "color", "$value": "{primitive.color.danger-ink}"},
        "background": {"$type": "color", "$value": "{primitive.color.danger-soft}"}
      },
      "success": {
        "foreground": {"$type": "color", "$value": "{primitive.color.success-ink}"},
        "background": {"$type": "color", "$value": "{primitive.color.success-soft}"}
      },
      "unknown": {
        "foreground": {"$type": "color", "$value": "{primitive.color.muted}"},
        "background": {"$type": "color", "$value": "{primitive.color.unknown-soft}"}
      }
    },
    "type": {
      "family": {"$type": "fontFamily", "$value": "{primitive.font.ui}"},
      "body": {"$type": "dimension", "$value": "{primitive.font.body}"},
      "label": {"$type": "dimension", "$value": "{primitive.font.label}"},
      "metadata": {"$type": "dimension", "$value": "{primitive.font.caption}"},
      "section": {"$type": "dimension", "$value": "{primitive.font.section}"},
      "page": {"$type": "dimension", "$value": "{primitive.font.page}"}
    }
  },
  "component": {
    "button": {
      "background": {"$type": "color", "$value": "{semantic.action.primary}"},
      "foreground": {"$type": "color", "$value": "{semantic.action.foreground}"},
      "hover": {"$type": "color", "$value": "{semantic.action.hover}"},
      "min-height": {"$type": "dimension", "$value": "{primitive.size.control}"},
      "touch-min-height": {"$type": "dimension", "$value": "{primitive.size.touch-control}"},
      "radius": {"$type": "dimension", "$value": "{primitive.radius.control}"},
      "padding-x": {"$type": "dimension", "$value": "{primitive.space.4}"}
    },
    "navigation": {
      "width": {"$type": "dimension", "$value": "{primitive.size.navigation}"},
      "background": {"$type": "color", "$value": "{semantic.surface.navigation}"},
      "foreground": {"$type": "color", "$value": "{semantic.text.inverse}"},
      "selected-background": {"$type": "color", "$value": "{semantic.surface.selected}"},
      "selected-foreground": {"$type": "color", "$value": "{semantic.text.selected}"},
      "item-min-height": {"$type": "dimension", "$value": "{primitive.size.touch-control}"}
    },
    "work-row": {
      "min-height": {"$type": "dimension", "$value": "{primitive.size.row}"},
      "touch-min-height": {"$type": "dimension", "$value": "{primitive.size.touch-row}"},
      "selected-background": {"$type": "color", "$value": "{semantic.surface.selected}"},
      "selected-border": {"$type": "color", "$value": "{semantic.border.selected}"},
      "gap": {"$type": "dimension", "$value": "{primitive.space.3}"}
    },
    "tabs": {
      "min-height": {"$type": "dimension", "$value": "{primitive.size.touch-control}"},
      "foreground": {"$type": "color", "$value": "{semantic.text.secondary}"},
      "selected-foreground": {"$type": "color", "$value": "{semantic.text.selected}"},
      "selected-line": {"$type": "color", "$value": "{semantic.border.selected}"}
    },
    "section": {
      "background": {"$type": "color", "$value": "{semantic.surface.panel}"},
      "padding": {"$type": "dimension", "$value": "{primitive.space.6}"},
      "gap": {"$type": "dimension", "$value": "{primitive.space.8}"},
      "radius": {"$type": "dimension", "$value": "{primitive.radius.panel}"}
    }
  }
}
