<mxfile host="app.diagrams.net"><diagram name="HarborLogi와 ROSY"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="HarborLogi → ROSY → 원본 대조 · 운영 책임과 근거" style="text;html=1;fontSize=24;fontColor=#152E49;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="50" as="geometry"/></mxCell>
<mxCell id="harbor" value="HarborLogi · 업무 담당자&#xa;화물·크기 → 요청·우선순위&#xa;관측 원본 → 계획&#xa;예상 배치와 실제 관측 분리" style="rounded=1;whiteSpace=wrap;fillColor=#E7F5F2;strokeColor=#168A81;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="370" height="160" as="geometry"/></mxCell>
<mxCell id="fleet" value="ROSY Fleet · 독립 운영자&#xa;ARM 제안 조회&#xa;digest·generation 확인 → 명시적 승인&#xa;제안자 자기 승인 금지" style="rounded=1;whiteSpace=wrap;fillColor=#EDF1F6;strokeColor=#152E49;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="510" y="110" width="370" height="160" as="geometry"/></mxCell>
<mxCell id="owner" value="ROSY 실행 소유자&#xa;자원·안전 조건 → 실행 → Action 결과&#xa;물리 완료와 업무 완료 별도" style="rounded=1;whiteSpace=wrap;fillColor=#EDF1F6;strokeColor=#152E49;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="980" y="110" width="370" height="160" as="geometry"/></mxCell>
<mxCell id="receipt" value="독립 물리 관측자 / Fleet&#xa;PRE_DISPATCH + POST_ACTION 측정&#xa;실행 시도에 연결된 physical receipt" style="rounded=1;whiteSpace=wrap;fillColor=#EDF1F6;strokeColor=#152E49;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="980" y="410" width="370" height="160" as="geometry"/></mxCell>
<mxCell id="reconcile" value="HarborLogi · 원본 대조&#xa;저장된 요청 키·신원·mission·digest 검증&#xa;UNKNOWN이면 같은 원본 조회 · 새 제안 금지" style="rounded=1;whiteSpace=wrap;fillColor=#E7F5F2;strokeColor=#168A81;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="510" y="410" width="370" height="160" as="geometry"/></mxCell>
<mxCell id="business" value="HarborLogi · 업무 완료 판단&#xa;반출 배치 + 재취급 복귀 + 관련 팔 퇴피&#xa;인증된 업무 근거 연결 필요&#xa;receipt만으로 완료 금지" style="rounded=1;whiteSpace=wrap;fillColor=#FFF0E5;strokeColor=#D66A26;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="370" height="160" as="geometry"/></mxCell>
<mxCell id="trip" value="입고 별도 경로 · 현장 담당자 확인(차량·화물·회차, 5분 유효) → Harbor 출발 전제 기록 → Fleet 운영자 직접 TRIP 실행&#xa;출발 전제 기록은 실제 차량 출발 증명이 아님" style="rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#168A81;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="1310" height="100" as="geometry"/></mxCell>
<mxCell id="e1" value="제안" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;" edge="1" parent="1" source="harbor" target="fleet"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" value="승인 후 수행" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;" edge="1" parent="1" source="fleet" target="owner"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" value="실행 전후 관측" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;" edge="1" parent="1" source="owner" target="receipt"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e4" value="원본 조회" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;" edge="1" parent="1" source="receipt" target="reconcile"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e5" value="근거 대조" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;" edge="1" parent="1" source="reconcile" target="business"><mxGeometry relative="1" as="geometry"/></mxCell>
